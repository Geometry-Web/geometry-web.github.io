# Copy to .env and start with:  node --env-file=.env src/server.js
# Never commit the filled-in file. Nothing here has a usable default secret.

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# SQLite file (created on first start). Use an absolute path on a deploy host.
DATABASE_FILE=./data/geometry-web.sqlite

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Sessions
SESSION_COOKIE_NAME=gd_session
SESSION_TTL_DAYS=30
# true in production (requires HTTPS); set false only for local http:// testing
COOKIE_SECURE=false

# Password hashing cost (bcrypt). 12 is a good default; 10 keeps tests fast.
BCRYPT_ROUNDS=12

# Comma-separated origins allowed to call the API with credentials.
# Include the GitHub Pages origin of the deployed front-end, e.g.
# https://your-user.github.io
ALLOWED_ORIGINS=http://localhost:8137,http://127.0.0.1:8137,http://localhost:8787

# Set to 1 behind a reverse proxy (nginx, Fly, Render) so rate limits see the
# real client address instead of the proxy's.
TRUST_PROXY=0

# Upload and throttling limits
MAX_LEVEL_BYTES=2097152
AUTH_WINDOW_MS=60000
AUTH_MAX_ATTEMPTS=10
REGISTER_WINDOW_MS=3600000
REGISTER_MAX_PER_IP=30
